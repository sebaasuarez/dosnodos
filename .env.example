# ── Dos Nodos — variables de entorno ──────────────────────────
# Copia este archivo a .env.local y completa los valores.

# Supabase (panel de administración + CRM). Sin estas variables el
# sitio público funciona igual con el contenido por defecto, pero el
# panel /admin queda inactivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones del formulario de contacto.
# RESEND_API_KEY, RESEND_FROM_EMAIL y ADMIN_EMAIL son obligatorias para
# confirmar al visitante y notificar al administrador. El dominio del
# remitente debe estar verificado en Resend.
GOOGLE_SHEETS_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Dos Nodos <hola@dosnodos.com.co>"
ADMIN_EMAIL=hola@dosnodos.com.co

# Chat con IA del sitio (opcional, usa Groq/OpenAI-compatible).
OPENAI_API_KEY=
